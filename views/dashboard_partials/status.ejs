<div class="col-12 col-xl-8">
    <div class="card dash-card h-100">
        <div class="card-body">
            <div class="chart-head">
                <h2 class="card-title">Sensor Status</h2>
                <span class="card-hint mb-0">Updated <span id="status-updated">—</span></span>
            </div>
            <div class="table-responsive">
                <table class="table status-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Sensor</th>
                            <th scope="col" class="d-none d-sm-table-cell">Hardware</th>
                            <th scope="col">Latest</th>
                            <th scope="col" class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% sensors.forEach(function (s) { %>
                        <tr>
                            <td>
                                <div class="sensor-cell">
                                    <img src="/assets/images/sensors/<%= s.image %>" alt="" loading="lazy">
                                    <span><%= s.label %></span>
                                </div>
                            </td>
                            <td class="d-none d-sm-table-cell text-secondary"><%= s.sensor %></td>
                            <td class="fw-medium" data-latest="<%= s.key %>">—</td>
                            <td class="text-end">
                                <span class="pill pill-muted" data-status="<%= s.status %>"><span class="dot"></span><span class="pill-text">Unknown</span></span>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
