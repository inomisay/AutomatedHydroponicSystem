<section class="row g-3" aria-label="Latest readings">
    <% sensors.forEach(function (s) { %>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="card dash-card kpi h-100" data-kpi="<%= s.key %>" style="--accent: <%= s.color %>">
            <div class="card-body">
                <div class="kpi-top">
                    <span class="kpi-icon"><i class="bi <%= s.icon %>"></i></span>
                    <span class="kpi-state state-muted" data-state>—</span>
                </div>
                <div class="kpi-label"><%= s.label %></div>
                <div class="kpi-value"><span data-value>—</span><small><%= s.unit %></small></div>
                <div class="kpi-target">Target <%= s.min %>–<%= s.max %></div>
            </div>
        </div>
    </div>
    <% }); %>
</section>
